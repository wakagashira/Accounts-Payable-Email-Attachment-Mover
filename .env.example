# Microsoft Graph (Multi-tenant)
# Tenant/app credentials are stored in SQL Server: dbo.Tenants (Active=1).
# These legacy fields are optional and are not used in multi-tenant mode.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
MAILBOX=ap@piperelectric.com  # legacy / optional

# SQL Server
SQL_SERVER=localhost
SQL_DATABASE=RaivenSync
SQL_USERNAME=
SQL_PASSWORD=
SQL_TRUSTED_CONNECTION=false

# Invoice subject filter
ENABLE_SUBJECT_FILTER=true
INVOICE_SUBJECT_KEYWORDS=invoice,bill,statement

# SFTP
SFTP_ENABLED=true
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PRIVATE_KEY_PATH=C:\FileZilla\crete-ssh
SFTP_REMOTE_BASE_DIR=/incoming/invoices

# Sync window
MAIL_SYNC_TYPE=Days          # Days | Span
MAIL_LOOKBACK_DAYS=30
MAIL_FROM_DATE=2025-01-01    # used when MAIL_SYNC_TYPE=Span
MAIL_TO_DATE=2025-03-01      # used when MAIL_SYNC_TYPE=Span

# Post-upload behavior
POST_UPLOAD_ACTION=ARCHIVE   # ARCHIVE | DELETE

# Loop settings
LOOP_ENABLED=false
LOOP_SLEEP_SECONDS=21600     # 6 hours
